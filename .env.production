# 🌐 Configuración del popup promocional
NEXT_PUBLIC_POPUP=on
NEXT_PUBLIC_POPUP_DELAY_MS=1200
NEXT_PUBLIC_POPUP_COOLDOWN_DAYS=7

# 📊 Analítica privada (Umami Cloud)
# ⚠️ Reemplaza este valor con tu ID real desde cloud.umami.is
NEXT_PUBLIC_UMAMI_ID=tu_id_unico_de_umami

# 🎥 Base pública para videos
# En producción apuntamos al CDN gratuito de jsDelivr sobre el repositorio
NEXT_PUBLIC_VIDEO_ASSET_BASE=https://cdn.jsdelivr.net/gh/rodriveracr/NoPainWebProject@main/public/videos

# ⚡ Entorno y dominio de producción
NEXT_PUBLIC_ENV=production
NEXT_PUBLIC_SITE_URL=https://www.nopainnumbing.net

# 🔒 Seguridad y optimizaciones
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
